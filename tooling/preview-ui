#!/usr/bin/env python3
"""Open the production UI in a development window and reload successful source edits."""
import argparse
import csv
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
PROCESS_ROOT = Path("/proc")


def nms_running():
    if os.name == "nt":
        result = subprocess.run(
            ["tasklist", "/FI", "IMAGENAME eq NMS.exe", "/FO", "CSV", "/NH"],
            capture_output=True, text=True, check=True,
        )
        return any(row and row[0].casefold() == "nms.exe" for row in csv.reader(result.stdout.splitlines()))
    for process in PROCESS_ROOT.iterdir():
        if not process.name.isdigit():
            continue
        try:
            if (process / "comm").read_text().strip().casefold() == "nms.exe":
                return True
        except (FileNotFoundError, ProcessLookupError):
            continue
    return False


def source_stamp():
    paths = [ROOT / "Cargo.toml", ROOT / "Cargo.lock", ROOT / "tooling/ui-preview/Cargo.toml", ROOT / "tooling/ui-preview/Cargo.lock"]
    paths.extend((ROOT / "tooling/ui-preview/src").rglob("*.rs"))
    for crate in ("ui", "model"):
        directory = ROOT / "crates" / crate
        paths.append(directory / "Cargo.toml")
        paths.extend(directory.rglob("*.rs"))
    return tuple(
        (str(path), path.stat().st_mtime_ns, path.stat().st_size)
        for path in sorted(paths)
        if path.is_file()
    )


def request_close(window, marker):
    if window is None or window.poll() is not None:
        return
    marker.touch()
    try:
        window.wait(timeout=5)
    except subprocess.TimeoutExpired:
        window.terminate()
        try:
            window.wait(timeout=2)
        except subprocess.TimeoutExpired:
            window.kill()
            window.wait()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--no-watch", action="store_true", help="open once without automatic reload")
    args = parser.parse_args()
    cargo = os.environ.get("CARGO") or shutil.which("cargo")
    if not cargo:
        candidate = Path.home() / ".cargo" / "bin" / "cargo"
        if candidate.is_file():
            cargo = str(candidate)
    if not cargo:
        parser.error("Rust is required; install cargo or set CARGO to its executable")
    target = Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "target" / "ui-preview"))
    if not target.is_absolute():
        target = ROOT / target
    binary = target / "debug" / ("search-probes-ui-preview.exe" if os.name == "nt" else "search-probes-ui-preview")
    command = [cargo, "build", "--locked", "--manifest-path", str(ROOT / "tooling/ui-preview/Cargo.toml")]
    build_environment = dict(os.environ, CARGO_TARGET_DIR=str(target))
    window = build = None
    version = 0
    dirty = True
    deadline = time.monotonic()
    stamp = source_stamp()
    reload_requested = False
    close_deadline = None
    paused = False

    with tempfile.TemporaryDirectory(prefix="search-probes-ui-preview-") as directory:
        scratch = Path(directory)
        marker = scratch / "reload"

        def launch():
            nonlocal version
            if nms_running():
                return None
            version += 1
            # Running a copy allows cargo to replace its build output on Windows as well.
            candidate = scratch / f"preview-{version}{binary.suffix}"
            shutil.copy2(binary, candidate)
            print("Opening Search Probes UI preview.", flush=True)
            return subprocess.Popen([str(candidate), "--reload-marker", str(marker)], cwd=ROOT)

        print("UI preview: source edits reload after a successful build. Close the window to stop.", flush=True)
        try:
            while True:
                now = time.monotonic()
                if nms_running():
                    if not paused:
                        print("NMS is running; UI preview suspended until the game exits.", flush=True)
                        request_close(window, marker)
                        window = None
                        marker.unlink(missing_ok=True)
                        reload_requested = False
                        close_deadline = None
                        paused = True
                    if build is not None and build.poll() is not None:
                        build = None
                    dirty = True
                    time.sleep(0.2)
                    continue
                if paused:
                    print("NMS has exited; resuming UI preview.", flush=True)
                    paused = False
                    deadline = now + 0.4
                if not args.no_watch:
                    current = source_stamp()
                    if current != stamp:
                        stamp = current
                        dirty = True
                        deadline = now + 0.4

                # Closing the window by hand also stops the watcher, including an in-flight build.
                if window is not None and window.poll() is not None:
                    if not reload_requested:
                        return window.returncode
                    marker.unlink(missing_ok=True)
                    window = launch()
                    reload_requested = False
                    close_deadline = None

                if build is not None and build.poll() is not None:
                    success = build.returncode == 0
                    build = None
                    if success:
                        if window is None:
                            window = launch()
                        elif not dirty:
                            print("Build passed; reopening preview with saved UI state.", flush=True)
                            marker.touch()
                            reload_requested = True
                            close_deadline = now + 5
                    else:
                        print("Build failed. Fix the source to retry; the existing preview stays open.", flush=True)
                        if args.no_watch:
                            return 1

                if reload_requested and now >= close_deadline:
                    request_close(window, marker)

                if dirty and build is None and not reload_requested and now >= deadline:
                    print("Building preview…", flush=True)
                    build = subprocess.Popen(command, cwd=ROOT, env=build_environment)
                    dirty = False

                time.sleep(0.2)
        except KeyboardInterrupt:
            return 0
        finally:
            if build is not None and build.poll() is None:
                build.terminate()
                build.wait()
            request_close(window, marker)


if __name__ == "__main__":
    sys.exit(main())
